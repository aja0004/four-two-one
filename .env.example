# Server-only API keys (NEVER prefix with NEXT_PUBLIC_)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Daily soft limit on Google Places API (New) text searches (keeps well within 1,000 free/month)
DAILY_PLACES_SOFT_LIMIT=30

# Supabase configuration for 2-iPhone live sync & household history
# (Optional for local Pass-the-Phone testing — falls back to localStorage automatically)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_HOUSEHOLD_ID=default
